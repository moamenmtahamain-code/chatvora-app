# ─── PRODUCTION API URL ──────────────────────────────────────────────────
# For Electron desktop app (bundled backend): leave commented or set to auto-detect
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000/api

# For web deployment (external backend on Render.com):
# Uncomment and set to your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://chatvora-backend.onrender.com/api