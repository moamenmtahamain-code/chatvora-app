PORT=5000

# الاتصال المحلي الرسمي والمستقر:
MONGO_URI=mongodb://localhost:27017/chatwave
MONGODB_URI=mongodb://localhost:27017/chatwave

DB_NAME=chatwave
JWT_SECRET=mysecretkey123
JWT_REFRESH_SECRET=myrefreshkey123
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads
CLIENT_URL=http://localhost:3000
STUN_SERVER=stun:stun.l.google.com:19302
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# Cloudinary (optional – leave blank to use local file storage)
# Get your credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Image Generation
# Option 1: Replicate (supports Flux, SDXL, etc.)
# Get your key at https://replicate.com/account/api-tokens
REPLICATE_API_KEY=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Option 2: OpenAI DALL·E (fallback if Replicate is not set)
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_API_URL=https://api.openai.com/v1/images/generations
AI_MODEL=dall-e-3
AI_IMAGE_SIZE=1024x1024
AI_QUALITY=standard