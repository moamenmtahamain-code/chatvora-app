PORT=5000
# MongoDB Atlas connection (native driver)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/chatwave?retryWrites=true&w=majority
# Local fallback name supported by older code:
MONGODB_URI=mongodb://localhost:27017/chatwave
# Database name (used with native driver)
DB_NAME=chatwave
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-pr
JWT_REFRESH_EXPIRE=30d

# Upload settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# CORS
# Optional comma-separated extra allowed browser origins. Private LAN origins
# such as http://192.168.x.x:3000 are allowed automatically for local use.
CLIENT_URL=

# WebRTC STUN/TURN servers (use your own in production)
STUN_SERVER=stun:stun.l.google.com:19302

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# AI IMAGE GENERATION PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
# At least ONE provider API key is required for real AI image generation.
# If no keys are set, the system runs in demo mode (placeholder images).
#
# The default provider to use when none is specified by the frontend:
AI_DEFAULT_PROVIDER=openai

# ─── 1. OpenAI (DALL·E 3 & GPT Image) ────────────────────────────────────────
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=dall-e-3
# OPENAI_QUALITY=standard
# OPENAI_API_URL=https://api.openai.com/v1/images/generations

# ─── 2. Google Gemini (Imagen) ───────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-preview-image-generation

# ─── 3. Stability AI (Stable Diffusion) ──────────────────────────────────────
# Get your API key at https://platform.stability.ai/account/keys
STABILITY_API_KEY=sk-your-stability-api-key-here
# STABILITY_MODEL=stable-diffusion-xl-1024-v1-0

# ─── 4. Replicate (Flux, SDXL, etc.) ─────────────────────────────────────────
# Get your API key at https://replicate.com/account/api-tokens
# Supports both REPLICATE_API_TOKEN and REPLICATE_API_KEY
REPLICATE_API_TOKEN=r8_your-replicate-api-token-here
# REPLICATE_MODEL=black-forest-labs/flux-schnell

# ─── 5. Fal.ai (Fast inference, Flux models) ─────────────────────────────────
# Get your API key at https://fal.ai/dashboard/keys
FAL_API_KEY=your-fal-api-key-here
# FAL_MODEL=fal-ai/flux/schnell